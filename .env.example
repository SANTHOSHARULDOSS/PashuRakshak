# PashuRakshak Environment Configuration (SIH 2026)
PORT=5000
NODE_ENV=development
DATABASE_URL=file:./pashurakshak.db
JWT_SECRET=your_jwt_secret_key_here
UPLOAD_DIR=./uploads

# Telephony & Gateways
SMS_PROVIDER=simulated_gov_sms
WHATSAPP_API_KEY=
IVR_TOLLFREE_NUMBER=1800-180-1551
WEATHER_API_KEY=

# Frontend Vite Config
VITE_API_BASE_URL=/api
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_APP_TITLE=PashuRakshak — Maharashtra Livestock Health Intelligence Platform
